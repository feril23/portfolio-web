# Supabase — leave blank to run in demo mode (bundled seed content).
# These must be prefixed with NEXT_PUBLIC_ so they are available in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for encrypted AI settings managed through the dashboard.
# Both values are server-only and must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Generate once with: openssl rand -base64 32
# Keep this stable. Changing it makes previously saved API keys unreadable.
AI_SETTINGS_ENCRYPTION_KEY=

# Optional OpenRouter fallback when no dashboard override has been saved.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Public site URL, used to build absolute hreflang/canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
